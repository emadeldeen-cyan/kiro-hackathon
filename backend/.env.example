# Server Configuration
PORT=3000
NODE_ENV=development

# Database Mode
# Set to 'true' to use in-memory database (no PostgreSQL required)
# Set to 'false' or remove to use PostgreSQL
USE_IN_MEMORY=true

# PostgreSQL Configuration (only needed if USE_IN_MEMORY=false)
# Uncomment these lines if you want to use PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=book_management
# DB_USER=postgres
# DB_PASSWORD=postgres

# MongoDB Configuration (Alternative - not currently implemented)
# MONGODB_URI=mongodb://localhost:27017/book_management

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS Configuration
# Comma-separated list of allowed frontend URLs
FRONTEND_URL=http://localhost:4200,http://localhost:4201

# OpenLibrary API
OPENLIBRARY_BASE_URL=https://openlibrary.org
